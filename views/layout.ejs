<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="bi bi-activity me-2"></i>ForgeYou
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <% if (isLoggedIn) { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/dashboard">
                                <i class="bi bi-house me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/activities">
                                <i class="bi bi-journal-plus me-1"></i>Actividades
                            </a>
                        </li>
                        <% if (user && (user.plan === 'smart' || user.plan === 'pro')) { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/training/plan">
                                <i class="bi bi-calendar-check me-1"></i>Mi Plan
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/progress/adaptations">
                                <i class="bi bi-graph-up-arrow me-1"></i>Progreso
                            </a>
                        </li>
                        <% } %>
                        <li class="nav-item">
                            <a class="nav-link" href="/reports">
                                <i class="bi bi-graph-up me-1"></i>Reportes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/suggestions">
                                <i class="bi bi-lightbulb me-1"></i>Consejos
                            </a>
                        </li>
                        <% } %>
                </ul>

                <ul class="navbar-nav">
                    <% if (isLoggedIn) { %>
                        <% if (user && (user.plan === 'smart' || user.plan === 'pro')) { %>
                        <li class="nav-item">
                            <a class="nav-link position-relative" href="/progress/adaptations" id="progressNotificationBell">
                                <i class="bi bi-bell fs-5"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="notificationCount" style="display: none;">
                                    0
                                </span>
                            </a>
                        </li>
                        <% } %>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>
                                <%= user.nombre %>
                                    <span class="badge bg-secondary ms-1">
                                        <%= user.plan.toUpperCase() %>
                                    </span>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>Perfil</a>
                                </li>
                                <% if (user && (user.plan === 'smart' || user.plan === 'pro')) { %>
                                <li><a class="dropdown-item" href="/training/plan"><i class="bi bi-calendar-check me-2"></i>Mi Plan de Entrenamiento</a>
                                </li>
                                <% } %>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <form action="/logout" method="POST" class="d-inline">
                                        <button type="submit" class="dropdown-item">
                                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                        <% } else { %>
                            <li class="nav-item">
                                <a class="nav-link" href="/login">Iniciar Sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/register">Registrarse</a>
                            </li>
                            <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Messages -->
    <% if (typeof message !=='undefined' && message) { %>
        <div class="alert alert-success alert-dismissible fade show m-0" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            <%= message %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

            <% if (typeof error !=='undefined' && error) { %>
                <div class="alert alert-danger alert-dismissible fade show m-0" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>
                    <!-- Bootstrap JS -->
                    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
                    <!-- Custom JS -->
                    <script src="/js/app.js"></script>
                    
                    <% if (isLoggedIn && user && (user.plan === 'smart' || user.plan === 'pro')) { %>
                    <script>
                        // Cargar notificaciones de progreso al cargar la página
                        async function loadProgressNotifications() {
                            try {
                                const response = await fetch('/progress/notifications');
                                if (response.ok) {
                                    const data = await response.json();
                                    const unreadNotifications = data.notifications.filter(n => !n.read_at);
                                    
                                    const notificationCount = document.getElementById('notificationCount');
                                    if (notificationCount && unreadNotifications.length > 0) {
                                        notificationCount.textContent = unreadNotifications.length;
                                        notificationCount.style.display = 'inline';
                                        
                                        // Agregar efecto de parpadeo si hay notificaciones importantes
                                        const hasImportantNotifications = unreadNotifications.some(n => 
                                            n.notification_type === 'stagnation_alert' || n.action_required
                                        );
                                        
                                        if (hasImportantNotifications) {
                                            const bell = document.getElementById('progressNotificationBell');
                                            bell.classList.add('notification-pulse');
                                        }
                                    }
                                }
                            } catch (error) {
                                console.warn('No se pudieron cargar las notificaciones de progreso:', error);
                            }
                        }

                        // Ejecutar al cargar la página
                        document.addEventListener('DOMContentLoaded', loadProgressNotifications);

                        // Actualizar notificaciones cada 5 minutos
                        setInterval(loadProgressNotifications, 5 * 60 * 1000);
                    </script>
                    
                    <style>
                        .notification-pulse {
                            animation: pulse 2s infinite;
                        }

                        @keyframes pulse {
                            0% {
                                transform: scale(1);
                            }
                            50% {
                                transform: scale(1.1);
                            }
                            100% {
                                transform: scale(1);
                            }
                        }
                    </style>
                    <% } %>
</body>

</html>