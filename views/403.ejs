<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <% if (user) { %>
        <!-- Navbar for logged users -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">
                <a class="navbar-brand fw-bold" href="/">
                    <i class="bi bi-activity me-2"></i>Athlyze
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/dashboard">
                                <i class="bi bi-house me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/activities">
                                <i class="bi bi-journal-plus me-1"></i>Actividades
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle btn btn-link text-white" type="button"
                                data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>
                                <%= user.nombre %>
                                    <span class="badge bg-secondary ms-1">
                                        <%= user.plan.toUpperCase() %>
                                    </span>
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <form action="/logout" method="POST" class="d-inline">
                                        <button type="submit" class="dropdown-item">
                                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <% } %>

            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <div class="text-center py-5">
                            <i class="bi bi-shield-lock display-1 text-warning mb-4"></i>
                            <h1 class="display-4 fw-bold text-dark mb-3">403</h1>
                            <h2 class="h4 mb-3">Acceso Denegado</h2>
                            <p class="lead text-muted mb-4">
                                <%= message || 'No tienes permisos para acceder a esta funcionalidad.' %>
                            </p>

                            <!-- Plan upgrade section for Smart/Pro features -->
                            <% if (user && user.plan==='starter' ) { %>
                                <div class="card mb-4 border-warning">
                                    <div class="card-body">
                                        <h5 class="card-title text-warning">
                                            <i class="bi bi-star me-2"></i>Mejora tu Plan
                                        </h5>
                                        <p class="card-text">
                                            Esta funcionalidad requiere <strong>Plan Smart</strong> o <strong>Plan
                                                Pro</strong>.
                                            Desbloquea todas las funciones premium de Athlyze.
                                        </p>

                                        <div class="row g-2 mb-3">
                                            <div class="col-md-6">
                                                <div class="p-3 bg-light rounded">
                                                    <h6 class="text-primary mb-2">
                                                        <i class="bi bi-check-circle me-1"></i>Plan Smart
                                                    </h6>
                                                    <ul class="list-unstyled small mb-0">
                                                        <li><i class="bi bi-check text-success me-1"></i>Planes de
                                                            entrenamiento IA</li>
                                                        <li><i class="bi bi-check text-success me-1"></i>Planes
                                                            alimenticios personalizados</li>
                                                        <li><i class="bi bi-check text-success me-1"></i>Reportes
                                                            avanzados</li>
                                                    </ul>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="p-3 bg-light rounded">
                                                    <h6 class="text-warning mb-2">
                                                        <i class="bi bi-star me-1"></i>Plan Pro
                                                    </h6>
                                                    <ul class="list-unstyled small mb-0">
                                                        <li><i class="bi bi-check text-success me-1"></i>Todo del Plan
                                                            Smart</li>
                                                        <li><i class="bi bi-check text-success me-1"></i>Análisis
                                                            biométrico avanzado</li>
                                                        <li><i class="bi bi-check text-success me-1"></i>Coaching
                                                            personalizado</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                                            <a href="/pricing" class="btn btn-warning me-md-2">
                                                <i class="bi bi-arrow-up-circle me-2"></i>Mejorar Plan
                                            </a>
                                            <a href="/dashboard" class="btn btn-outline-primary">
                                                <i class="bi bi-house me-2"></i>Ir al Dashboard
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <% } else { %>
                                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                                        <a href="/dashboard" class="btn btn-primary me-md-2">
                                            <i class="bi bi-house me-2"></i>Ir al Dashboard
                                        </a>
                                        <a href="javascript:history.back()" class="btn btn-outline-secondary">
                                            <i class="bi bi-arrow-left me-2"></i>Volver
                                        </a>
                                    </div>
                                    <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bootstrap JS -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>