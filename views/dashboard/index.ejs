                    <div class="card border-0 shadow-sm bg-info">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center">
                                <div class="me-3">
                                    <i class="bi bi-gem text-white fs-2"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="text-white mb-1">¡Personaliza tu Entrenamiento!</h5>
                                    <p class="text-white mb-2 small">Accede a nuestra herramienta de IA para crear un
                                        plan de entrenamiento a tu medida.</p>
                                </div>
                                <div>
                                    <a href="/training/setup"
                                        class="btn btn-light fw-bold personalized-training-button">Crear Plan</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="card border-0 shadow-sm bg-primary">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center">
                                <div class="me-3">
                                    <i class="bi bi-apple            text-white fs-2"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="text-white mb-1">¡Personaliza tu Plan Nutricional!</h5>
                                    <p class="text-white mb-2 small">Accede a nuestra herramienta de IA para crear un
                                        plan alimenticio a tu medida.</p>
                                </div>
                                <div>
                                    <a href="/nutrition/setup"
                                        class="btn btn-light fw-bold personalized-training-button">Crear Plan</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="card border-0 shadow-sm bg-success">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center">
                                <div class="me-3">
                                    <i class="bi bi-calendar-check text-white fs-2"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="text-white mb-1">Mi Plan Actual</h5>
                                    <p class="text-white mb-2 small">Continúa con tu rutina personalizada y registra tu
                                        progreso.</p>
                                </div>
                                <div>
                                    <a href="/training/plan" class="btn btn-light fw-bold">Ver Plan</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="card border-0 shadow-sm bg-info">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center">
                                <div class="me-3">
                                    <i class="bi bi-graph-up-arrow text-white fs-2"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="text-white mb-1">Evaluación de Progreso</h5>
                                    <p class="text-white mb-2 small">Analiza tu progreso y recibe adaptaciones
                                        automáticas de tu plan.</p>
                                </div>
                                <div>
                                    <a href="/progress/adaptations" class="btn btn-light fw-bold">Evaluar</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="card border-0 shadow-sm bg-warning">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center">
                                <div class="me-3">
                                    <i class="bi bi-ruler text-white fs-2"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="text-white mb-1">Registro de Medidas</h5>
                                    <p class="text-white mb-2 small">Registra tus medidas corporales para un seguimiento
                                        preciso.</p>
                                </div>
                                <div>
                                    <button class="btn btn-light fw-bold"
                                        onclick="showMeasurementsModal()">Registrar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Feedback Personalizado - Solo para usuarios PRO -->
                <% if (user.plan==='pro' ) { %>
                    <div class="col-md-6 mb-3">
                        <div class="card border-0 shadow-sm"
                            style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center">
                                    <div class="me-3">
                                        <i class="bi bi-chat-dots text-white fs-2"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h5 class="text-white mb-1 fw-bold">Coach & Nutricionista</h5>
                                        <p class="text-white mb-2 small opacity-90">Recibe feedback personalizado y
                                            revisiones semanales de profesionales.</p>
                                    </div>
                                    <div>
                                        <button class="btn btn-light fw-bold" onclick="showCoachFeedbackModal()">
                                            <i class="bi bi-person-check me-1"></i>Consultar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>
            </div>
            <% } %>

                <!-- Statistics Cards -->
                <div class="row mb-4">
                    <!-- Centrar el titulo en la parte superior de la columna -->
                    <div class="col-md-12 text-center">
                        <h2 class="mb-4">Historial de actividades</h2>
                    </div>
                    <div class="col-md-3 col-sm-6 mb-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                                        <i class="bi bi-activity fs-4 text-primary"></i>
                                    </div>
                                    <div>
                                        <h3 class="fw-bold mb-1">
                                            <%= stats.total_actividades %>
                                        </h3>
                                        <p class="text-muted small mb-0">Total actividades</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6 mb-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
                                        <i class="bi bi-heart-pulse fs-4 text-success"></i>
                                    </div>
                                    <div>
                                        <h3 class="fw-bold mb-1">
                                            <%= stats.ejercicios %>
                                        </h3>
                                        <p class="text-muted small mb-0">Ejercicios</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6 mb-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="bg-warning bg-opacity-10 rounded-circle p-3 me-3">
                                        <i class="bi bi-egg-fried fs-4 text-warning"></i>
                                    </div>
                                    <div>
                                        <h3 class="fw-bold mb-1">
                                            <%= stats.comidas %>
                                        </h3>
                                        <p class="text-muted small mb-0">Comidas</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6 mb-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="bg-info bg-opacity-10 rounded-circle p-3 me-3">
                                        <i class="bi bi-speedometer2 fs-4 text-info"></i>
                                    </div>
                                    <div>
                                        <h3 class="fw-bold mb-1">
                                            <%= stats.medidas %>
                                        </h3>
                                        <p class="text-muted small mb-0">Medidas tomadas</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Chart Section -->
                    <div class="col-lg-8 mb-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-light border-0">
                                <h5 class="mb-0">
                                    <i class="bi bi-bar-chart me-2"></i>Actividades de la Semana
                                </h5>
                            </div>
                            <div class="card-body">
                                <canvas id="weeklyChart" height="300"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Activities -->
                    <div class="col-lg-4 mb-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div
                                class="card-header bg-light border-0 d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="bi bi-clock-history me-2"></i>Actividades Recientes
                                </h5>
                                <a href="/activities" class="btn btn-sm btn-outline-primary">Ver todas</a>
                            </div>
                            <div class="card-body">
                                <% if (recentActivities.length> 0) { %>
                                    <% recentActivities.forEach(activity=> { %>
                                        <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                                            <div class="me-3">
                                                <% if (activity.tipo==='ejercicio' ) { %>
                                                    <i class="bi bi-heart-pulse text-success fs-5"></i>
                                                    <% } else if (activity.tipo==='alimentacion' ) { %>
                                                        <i class="bi bi-egg-fried text-warning fs-5"></i>
                                                        <% } else { %>
                                                            <i class="bi bi-speedometer2 text-info fs-5"></i>
                                                            <% } %>
                                            </div>
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1 fw-semibold">
                                                    <%= activity.descripcion.substring(0, 40) %>
                                                        <%= activity.descripcion.length> 40 ? '...' : '' %>
                                                </h6>
                                                <small class="text-muted">
                                                    <%= new Date(activity.fecha).toLocaleDateString('es-ES', {
                                                        weekday: 'short' , month: 'short' , day: 'numeric' }) %>
                                                        <% if (activity.calorias) { %>
                                                            • <%= activity.calorias %> cal
                                                                <% } %>
                                                </small>
                                            </div>
                                        </div>
                                        <% }) %>
                                            <% } else { %>
                                                <div class="text-center text-muted py-4">
                                                    <i class="bi bi-journal-plus fs-2 mb-2"></i>
                                                    <p class="mb-0">No hay actividades recientes</p>
                                                    <a href="/activities/new" class="btn btn-sm btn-primary mt-2">
                                                        Registrar primera actividad
                                                    </a>
                                                </div>
                                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Suggestions Section -->
                <% if (suggestions.length> 0) { %>
                    <div class="row">
                        <div class="col-12">
                            <div class="card border-0 shadow-sm">
                                <div
                                    class="card-header bg-light border-0 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">
                                        <i class="bi bi-lightbulb me-2"></i>Consejos Personalizados
                                    </h5>
                                    <a href="/suggestions" class="btn btn-sm btn-outline-primary">Ver todos</a>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <% suggestions.forEach(suggestion=> { %>
                                            <div class="col-md-4 mb-3">
                                                <div class="alert alert-info border-0 shadow-sm mb-0">
                                                    <div class="d-flex">
                                                        <i class="bi bi-info-circle me-2 mt-1"></i>
                                                        <div>
                                                            <p class="mb-1 fw-semibold">
                                                                <%= suggestion.texto %>
                                                            </p>
                                                            <small class="text-muted">
                                                                <%= new
                                                                    Date(suggestion.fecha).toLocaleDateString('es-ES')
                                                                    %>
                                                            </small>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }) %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Chart Script -->
    <script>
        // Weekly Activities Chart
        const chartData = JSON.parse('<%- chartData %>');

        // Prepare data for chart
        const dates = chartData.map(d => new Date(d.fecha).toLocaleDateString('es-ES', {
            month: 'short',
            day: 'numeric'
        }));
        const activities = chartData.map(d => parseInt(d.total_actividades));
        const exercises = chartData.map(d => parseInt(d.ejercicios));
        const calories = chartData.map(d => parseInt(d.total_calorias) || 0);

        const ctx = document.getElementById('weeklyChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: dates,
                datasets: [
                    {
                        label: 'Total Actividades',
                        data: activities,
                        borderColor: '#0d6efd',
                        backgroundColor: '#0d6efd20',
                        fill: true,
                        tension: 0.4
                    },
                    {
                        label: 'Ejercicios',
                        data: exercises,
                        borderColor: '#198754',
                        backgroundColor: '#19875420',
                        fill: false,
                        tension: 0.4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                },
                interaction: {
                    mode: 'nearest',
                    axis: 'x',
                    intersect: false
                }
            }
        });
    </script>

    <!-- Modal para Registrar Medidas -->
    <div class="modal fade" id="measurementsModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-ruler me-2"></i>
                        Registrar Medidas Corporales
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="measurementsForm">
                    <div class="modal-body">
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Importante:</strong> El registro regular de medidas es esencial para el sistema de
                            adaptación automática de tu plan.
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="weight" class="form-label">Peso (kg) *</label>
                                    <input type="number" step="0.1" class="form-control" id="weight" name="weight"
                                        required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="body_fat_percentage" class="form-label">% Grasa Corporal</label>
                                    <input type="number" step="0.1" class="form-control" id="body_fat_percentage"
                                        name="body_fat_percentage">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="muscle_mass" class="form-label">Masa Muscular (kg)</label>
                                    <input type="number" step="0.1" class="form-control" id="muscle_mass"
                                        name="muscle_mass">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="waist_circumference" class="form-label">Cintura (cm)</label>
                                    <input type="number" step="0.1" class="form-control" id="waist_circumference"
                                        name="waist_circumference">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="chest_circumference" class="form-label">Pecho (cm)</label>
                                    <input type="number" step="0.1" class="form-control" id="chest_circumference"
                                        name="chest_circumference">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="resting_heart_rate" class="form-label">FC Reposo (bpm)</label>
                                    <input type="number" class="form-control" id="resting_heart_rate"
                                        name="resting_heart_rate">
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-3">
                                    <label for="notes" class="form-label">Notas Adicionales</label>
                                    <textarea class="form-control" id="notes" name="notes" rows="3"
                                        placeholder="Ej: Me siento más fuerte esta semana, he notado mejoras en resistencia..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Guardar Medidas
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Función para mostrar modal de medidas
        function showMeasurementsModal() {
            const modal = new bootstrap.Modal(document.getElementById('measurementsModal'));
            modal.show();
        }

        // Manejar envío del formulario de medidas
        document.getElementById('measurementsForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            const submitBtn = this.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;

            try {
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Guardando...';
                submitBtn.disabled = true;

                const response = await fetch('/progress/measurements', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    showNotification('Medidas registradas correctamente. ¡Excelente trabajo!', 'success');
                    bootstrap.Modal.getInstance(document.getElementById('measurementsModal')).hide();
                    this.reset();
                } else {
                    throw new Error(result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                showNotification('Error al registrar medidas: ' + error.message, 'danger');
            } finally {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        });

        // Función para mostrar notificaciones
        function showNotification(message, type = 'info') {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 1055; min-width: 300px;';
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;

            document.body.appendChild(alertDiv);

            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.remove();
                }
            }, 5000);
        }
    </script>

    <!-- Modal para Coach & Nutricionista - Solo para usuarios PRO -->
