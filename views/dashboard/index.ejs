        <div class="modal fade" id="coachFeedbackModal" tabindex="-1">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header text-white"
                        style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;">
                        <h5 class="modal-title text-white fw-bold">
                            <i class="bi bi-chat-dots me-2"></i>
                            Centro de Comunicación Profesional
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                            aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-0">
                        <div class="row g-0">
                            <!-- Coach Section -->
                            <div class="col-md-6 p-4 border-end">
                                <div class="text-center mb-4">
                                    <div class="bg-success bg-opacity-10 rounded-circle p-3 d-inline-flex mb-3">
                                        <i class="bi bi-person-badge fs-1 text-success"></i>
                                    </div>
                                    <h5 class="fw-bold">Tu Coach Personal</h5>
                                    <p class="text-muted small">Entrenador certificado especializado en tu objetivo</p>
                                </div>

                                <div class="coach-messages"
                                    style="height: 300px; overflow-y: auto; background: #f8f9fa; border-radius: 10px; padding: 15px;">
                                    <div class="message mb-3">
                                        <div class="d-flex align-items-start">
                                            <div class="bg-success rounded-circle p-2 me-2">
                                                <i class="bi bi-person-check text-white"></i>
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="bg-white rounded p-3 shadow-sm">
                                                    <p class="mb-1"><strong>Coach Martinez</strong></p>
                                                    <p class="mb-1 small">¡Excelente progreso esta semana! He revisado
                                                        tus entrenamientos y veo mejoras consistentes en tu resistencia.
                                                    </p>
                                                    <small class="text-muted">Hace 2 días</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="message mb-3">
                                        <div class="d-flex align-items-start">
                                            <div class="bg-success rounded-circle p-2 me-2">
                                                <i class="bi bi-person-check text-white"></i>
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="bg-white rounded p-3 shadow-sm">
                                                    <p class="mb-1"><strong>Coach Martinez</strong></p>
                                                    <p class="mb-1 small">Para la próxima semana, te sugiero aumentar el
                                                        peso en sentadillas. Tu forma está perfecta, es momento de
                                                        progresar.</p>
                                                    <small class="text-muted">Hace 1 día</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="message mb-3">
                                        <div class="d-flex align-items-start justify-content-end">
                                            <div class="flex-grow-1 text-end me-2">
                                                <div class="bg-primary rounded p-3 shadow-sm text-white d-inline-block">
                                                    <p class="mb-1 small">¿Puedo agregar más cardio a mi rutina?</p>
                                                    <small class="opacity-75">Hace 1 hora</small>
                                                </div>
                                            </div>
                                            <div class="bg-primary rounded-circle p-2">
                                                <i class="bi bi-person text-white"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <div class="input-group">
                                        <input type="text" class="form-control"
                                            placeholder="Escribe tu mensaje al coach..." id="coachMessage">
                                        <button class="btn btn-success" type="button" onclick="sendCoachMessage()">
                                            <i class="bi bi-send"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Nutricionista Section -->
                            <div class="col-md-6 p-4">
                                <div class="text-center mb-4">
                                    <div class="bg-warning bg-opacity-10 rounded-circle p-3 d-inline-flex mb-3">
                                        <i class="bi bi-apple fs-1 text-warning"></i>
                                    </div>
                                    <h5 class="fw-bold">Tu Nutricionista</h5>
                                    <p class="text-muted small">Especialista en nutrición deportiva</p>
                                </div>

                                <div class="nutritionist-messages"
                                    style="height: 300px; overflow-y: auto; background: #f8f9fa; border-radius: 10px; padding: 15px;">
                                    <div class="message mb-3">
                                        <div class="d-flex align-items-start">
                                            <div class="bg-warning rounded-circle p-2 me-2">
                                                <i class="bi bi-apple text-white"></i>
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="bg-white rounded p-3 shadow-sm">
                                                    <p class="mb-1"><strong>Dra. Rodriguez</strong></p>
                                                    <p class="mb-1 small">He revisado tu ingesta calórica de esta
                                                        semana. Está muy bien balanceada. Te sugiero aumentar la
                                                        proteína post-entreno.</p>
                                                    <small class="text-muted">Hace 1 día</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="message mb-3">
                                        <div class="d-flex align-items-start">
                                            <div class="bg-warning rounded-circle p-2 me-2">
                                                <i class="bi bi-apple text-white"></i>
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="bg-white rounded p-3 shadow-sm">
                                                    <p class="mb-1"><strong>Dra. Rodriguez</strong></p>
                                                    <p class="mb-1 small">¿Cómo te sientes con el plan nutricional? He
                                                        visto mejoras en tus niveles de energía según tus registros.</p>
                                                    <small class="text-muted">Hace 6 horas</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="message mb-3">
                                        <div class="d-flex align-items-start justify-content-end">
                                            <div class="flex-grow-1 text-end me-2">
                                                <div class="bg-primary rounded p-3 shadow-sm text-white d-inline-block">
                                                    <p class="mb-1 small">Me siento con más energía, gracias!</p>
                                                    <small class="opacity-75">Hace 2 horas</small>
                                                </div>
                                            </div>
                                            <div class="bg-primary rounded-circle p-2">
                                                <i class="bi bi-person text-white"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <div class="input-group">
                                        <input type="text" class="form-control"
                                            placeholder="Escribe tu mensaje al nutricionista..."
                                            id="nutritionistMessage">
                                        <button class="btn btn-warning" type="button"
                                            onclick="sendNutritionistMessage()">
                                            <i class="bi bi-send"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <div class="d-flex justify-content-between align-items-center w-100">
                            <div class="text-muted small">
                                <i class="bi bi-shield-check me-1"></i>
                                Comunicación segura y privada con profesionales certificados
                            </div>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            // Función para mostrar modal del coach
            function showCoachFeedbackModal() {
                const modal = new bootstrap.Modal(document.getElementById('coachFeedbackModal'));
                modal.show();
            }

            // Simular envío de mensaje al coach
            function sendCoachMessage() {
                const messageInput = document.getElementById('coachMessage');
                const message = messageInput.value.trim();

                if (message === '') return;

                const coachMessages = document.querySelector('.coach-messages');
                const messageDiv = document.createElement('div');
                messageDiv.className = 'message mb-3';
                messageDiv.innerHTML = `
                <div class="d-flex align-items-start justify-content-end">
                    <div class="flex-grow-1 text-end me-2">
                        <div class="bg-primary rounded p-3 shadow-sm text-white d-inline-block">
                            <p class="mb-1 small">${message}</p>
                            <small class="opacity-75">Ahora mismo</small>
                        </div>
                    </div>
                    <div class="bg-primary rounded-circle p-2">
                        <i class="bi bi-person text-white"></i>
                    </div>
                </div>
            `;

                coachMessages.appendChild(messageDiv);
                coachMessages.scrollTop = coachMessages.scrollHeight;
                messageInput.value = '';

                // Simular respuesta automática del coach después de 2 segundos
                setTimeout(() => {
                    const responseDiv = document.createElement('div');
                    responseDiv.className = 'message mb-3';
                    responseDiv.innerHTML = `
                    <div class="d-flex align-items-start">
                        <div class="bg-success rounded-circle p-2 me-2">
                            <i class="bi bi-person-check text-white"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="bg-white rounded p-3 shadow-sm">
                                <p class="mb-1"><strong>Coach Martinez</strong></p>
                                <p class="mb-1 small">Gracias por tu mensaje. He revisado tu consulta y te responderé con recomendaciones específicas pronto.</p>
                                <small class="text-muted">Ahora mismo</small>
                            </div>
                        </div>
                    </div>
                `;
                    coachMessages.appendChild(responseDiv);
                    coachMessages.scrollTop = coachMessages.scrollHeight;
                }, 2000);
            }

            // Simular envío de mensaje al nutricionista
            function sendNutritionistMessage() {
                const messageInput = document.getElementById('nutritionistMessage');
                const message = messageInput.value.trim();

                if (message === '') return;

                const nutritionistMessages = document.querySelector('.nutritionist-messages');
                const messageDiv = document.createElement('div');
                messageDiv.className = 'message mb-3';
                messageDiv.innerHTML = `
                <div class="d-flex align-items-start justify-content-end">
                    <div class="flex-grow-1 text-end me-2">
                        <div class="bg-primary rounded p-3 shadow-sm text-white d-inline-block">
                            <p class="mb-1 small">${message}</p>
                            <small class="opacity-75">Ahora mismo</small>
                        </div>
                    </div>
                    <div class="bg-primary rounded-circle p-2">
                        <i class="bi bi-person text-white"></i>
                    </div>
                </div>
            `;

                nutritionistMessages.appendChild(messageDiv);
                nutritionistMessages.scrollTop = nutritionistMessages.scrollHeight;
                messageInput.value = '';

                // Simular respuesta automática del nutricionista después de 3 segundos
                setTimeout(() => {
                    const responseDiv = document.createElement('div');
                    responseDiv.className = 'message mb-3';
                    responseDiv.innerHTML = `
                    <div class="d-flex align-items-start">
                        <div class="bg-warning rounded-circle p-2 me-2">
                            <i class="bi bi-apple text-white"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="bg-white rounded p-3 shadow-sm">
                                <p class="mb-1"><strong>Dra. Rodriguez</strong></p>
                                <p class="mb-1 small">Perfecto, revisaré tu plan nutricional y te daré recomendaciones personalizadas basadas en tu progreso actual.</p>
                                <small class="text-muted">Ahora mismo</small>
                            </div>
                        </div>
                    </div>
                `;
                    nutritionistMessages.appendChild(responseDiv);
                    nutritionistMessages.scrollTop = nutritionistMessages.scrollHeight;
                }, 3000);
            }

            // Permitir envío con Enter
            document.addEventListener('DOMContentLoaded', function () {
                const coachInput = document.getElementById('coachMessage');
                const nutritionistInput = document.getElementById('nutritionistMessage');

                if (coachInput) {
                    coachInput.addEventListener('keypress', function (e) {
                        if (e.key === 'Enter') {
                            sendCoachMessage();
                        }
                    });
                }

                if (nutritionistInput) {
                    nutritionistInput.addEventListener('keypress', function (e) {
                        if (e.key === 'Enter') {
                            sendNutritionistMessage();
                        }
                    });
                }
            });
        </script>
        <% } %>
</body>

</html>