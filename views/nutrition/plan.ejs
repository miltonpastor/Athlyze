<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="bi bi-activity me-2"></i>ForgeYou
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="/dashboard">
                            <i class="bi bi-house me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/activities">
                            <i class="bi bi-journal-plus me-1"></i>Actividades
                        </a>
                    </li>
                    <% if (user && (user.plan==='smart' || user.plan==='pro' )) { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/training/plan">
                                <i class="bi bi-calendar-check me-1"></i>Mi Plan
                            </a>
                        </li>
                        <% } %>
                            <% if (user.plan==='smart' || user.plan==='pro' ) { %>
                                <li class="nav-item">
                                    <a class="nav-link" href="/nutrition">
                                        <i class="bi bi-apple me-1"></i>Nutrición
                                    </a>
                                </li>
                                <% } %>
                                    <li class="nav-item">
                                        <a class="nav-link" href="/reports">
                                            <i class="bi bi-graph-up me-1"></i>Reportes
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" href="/suggestions">
                                            <i class="bi bi-lightbulb me-1"></i>Consejos
                                        </a>
                                    </li>
                </ul>

                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle btn btn-link text-white" type="button"
                            data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>
                            <%= user.nombre %>
                                <span class="badge bg-secondary ms-1">
                                    <%= user.plan.toUpperCase() %>
                                </span>
                        </button>
                        <ul class="dropdown-menu">
                            <% if (user && (user.plan==='smart' || user.plan==='pro' )) { %>
                                <li><a class="dropdown-item" href="/training/plan"><i
                                            class="bi bi-calendar-check me-2"></i>Mi Plan de Entrenamiento</a></li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <% } %>
                                    <li>
                                        <form action="/logout" method="POST" class="d-inline">
                                            <button type="submit" class="dropdown-item">
                                                <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                                            </button>
                                        </form>
                                    </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


    <div class="container py-4">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-md-8">
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-magic fs-2 text-success me-3"></i>
                    <div>
                        <h2 class="mb-1">
                            <%= plan.title %>
                        </h2>
                        <p class="text-muted mb-0">
                            <%= plan.description %>
                                <% if (typeof created_at !=='undefined' ) { %>
                                    <br><small>Generado el <%= new Date(created_at).toLocaleDateString('es-ES') %>
                                    </small>
                                    <% } %>
                        </p>
                    </div>
                </div>

                <!-- Plan Summary -->
                <div class="card bg-gradient-primary text-white border-0 mb-4">
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-6 col-md-3">
                                <div class="mb-2">
                                    <i class="bi bi-calendar-week fs-4"></i>
                                </div>
                                <div class="fw-bold fs-5">
                                    <%= plan.total_days %>
                                </div>
                                <div class="small">Días</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="mb-2">
                                    <i class="bi bi-target fs-4"></i>
                                </div>
                                <div class="fw-bold fs-5 text-capitalize">
                                    <%= plan.goal.replace('_', ' ' ) %>
                                </div>
                                <div class="small">Objetivo</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="mb-2">
                                    <i class="bi bi-lightning fs-4"></i>
                                </div>
                                <div class="fw-bold fs-5">
                                    <%= Math.round(plan.week_plan.reduce((sum, day)=> sum + day.total_calories, 0) /
                                        plan.week_plan.length) %>
                                </div>
                                <div class="small">Cal/día promedio</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="mb-2">
                                    <i class="bi bi-egg-fried fs-4"></i>
                                </div>
                                <div class="fw-bold fs-5">
                                    <%= plan.week_plan[0].meals.length %>
                                </div>
                                <div class="small">Comidas/día</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4 text-md-end">
                <div class="d-grid gap-2 d-md-block">
                    <a href="/nutrition/setup" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-gear me-2"></i>Modificar Plan
                    </a>
                </div>
            </div>
        </div>

        <!-- Week Plan Tabs -->
        <div class="card border-0 shadow">
            <div class="card-header bg-light border-0">
                <ul class="nav nav-tabs card-header-tabs" id="dayTabs" role="tablist">
                    <% plan.week_plan.forEach((day, index)=> { %>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link <%= index === 0 ? 'active' : '' %>" id="day<%= index + 1 %>-tab"
                                data-bs-toggle="tab" data-bs-target="#day<%= index + 1 %>" type="button" role="tab">
                                <%= day.day %>
                                    <small class="d-block text-muted">
                                        <%= day.date %>
                                    </small>
                            </button>
                        </li>
                        <% }); %>
                </ul>
            </div>

            <div class="card-body p-0">
                <div class="tab-content" id="dayTabsContent">
                    <% plan.week_plan.forEach((day, dayIndex)=> { %>
                        <div class="tab-pane fade <%= dayIndex === 0 ? 'show active' : '' %>"
                            id="day<%= dayIndex + 1 %>" role="tabpanel">

                            <!-- Daily Summary -->
                            <div class="bg-light p-3 border-bottom">
                                <div class="row text-center">
                                    <div class="col-6 col-md-3">
                                        <div class="fw-bold text-primary">
                                            <%= Math.round(day.total_calories) %>
                                        </div>
                                        <div class="small text-muted">Calorías</div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="fw-bold text-success">
                                            <%= Math.round(day.total_protein) %>g
                                        </div>
                                        <div class="small text-muted">Proteína</div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="fw-bold text-warning">
                                            <%= Math.round(day.total_carbs) %>g
                                        </div>
                                        <div class="small text-muted">Carbohidratos</div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="fw-bold text-info">
                                            <%= Math.round(day.total_fats) %>g
                                        </div>
                                        <div class="small text-muted">Grasas</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Meals for the day -->
                            <div class="p-3">
                                <% day.meals.forEach((meal, mealIndex)=> { %>
                                    <div class="meal-card mb-4">
                                        <div class="row align-items-start">
                                            <div class="col-md-4">
                                                <div class="meal-header">
                                                    <div class="d-flex align-items-center mb-2">
                                                        <% if (meal.meal_type==='breakfast' ) { %>
                                                            <i class="bi bi-sunrise text-warning fs-4 me-3"></i>
                                                            <% } else if (meal.meal_type==='lunch' ) { %>
                                                                <i class="bi bi-sun text-success fs-4 me-3"></i>
                                                                <% } else if (meal.meal_type==='dinner' ) { %>
                                                                    <i class="bi bi-moon text-primary fs-4 me-3"></i>
                                                                    <% } else { %>
                                                                        <i class="bi bi-cup text-info fs-4 me-3"></i>
                                                                        <% } %>
                                                                            <div>
                                                                                <h5 class="mb-0">
                                                                                    <%= meal.meal_name %>
                                                                                </h5>
                                                                                <small
                                                                                    class="text-muted text-capitalize">
                                                                                    <%= meal.meal_type %>
                                                                                </small>
                                                                            </div>
                                                    </div>

                                                    <div class="meal-stats bg-light p-2 rounded mb-3">
                                                        <div class="row text-center small">
                                                            <div class="col-3">
                                                                <div class="fw-bold">
                                                                    <%= meal.calories %>
                                                                </div>
                                                                <div class="text-muted">Cal</div>
                                                            </div>
                                                            <div class="col-3">
                                                                <div class="fw-bold">
                                                                    <%= Math.round(meal.protein) %>g
                                                                </div>
                                                                <div class="text-muted">Prot</div>
                                                            </div>
                                                            <div class="col-3">
                                                                <div class="fw-bold">
                                                                    <%= Math.round(meal.carbs) %>g
                                                                </div>
                                                                <div class="text-muted">Carb</div>
                                                            </div>
                                                            <div class="col-3">
                                                                <div class="fw-bold">
                                                                    <%= Math.round(meal.fats) %>g
                                                                </div>
                                                                <div class="text-muted">Gras</div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="meal-info">
                                                        <div
                                                            class="d-flex justify-content-between small text-muted mb-2">
                                                            <span><i class="bi bi-clock me-1"></i>Tiempo: <%=
                                                                    meal.preparation_time %> min</span>
                                                            <span><i class="bi bi-star me-1"></i>
                                                                <%= meal.difficulty %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-8">
                                                <div class="foods-list">
                                                    <h6 class="text-muted mb-3">Ingredientes:</h6>
                                                    <div class="row">
                                                        <% meal.foods.forEach(food=> { %>
                                                            <div class="col-md-6 mb-2">
                                                                <div class="food-item d-flex align-items-center">
                                                                    <div class="food-icon me-2">
                                                                        <% if (food.name.toLowerCase().includes('pollo')
                                                                            || food.name.toLowerCase().includes('pavo'))
                                                                            { %>
                                                                            <i
                                                                                class="bi bi-circle-fill text-warning"></i>
                                                                            <% } else if
                                                                                (food.name.toLowerCase().includes('pescado')
                                                                                ||
                                                                                food.name.toLowerCase().includes('salmón')
                                                                                ||
                                                                                food.name.toLowerCase().includes('atún'))
                                                                                { %>
                                                                                <i
                                                                                    class="bi bi-circle-fill text-info"></i>
                                                                                <% } else if
                                                                                    (food.name.toLowerCase().includes('huevo'))
                                                                                    { %>
                                                                                    <i
                                                                                        class="bi bi-circle-fill text-danger"></i>
                                                                                    <% } else if
                                                                                        (food.name.includes('lentejas')
                                                                                        ||
                                                                                        food.name.includes('garbanzos')
                                                                                        || food.name.includes('quinoa'))
                                                                                        { %>
                                                                                        <i
                                                                                            class="bi bi-circle-fill text-success"></i>
                                                                                        <% } else { %>
                                                                                            <i
                                                                                                class="bi bi-circle-fill text-secondary"></i>
                                                                                            <% } %>
                                                                    </div>
                                                                    <div class="flex-grow-1">
                                                                        <div class="fw-semibold">
                                                                            <%= food.name %>
                                                                        </div>
                                                                        <small class="text-muted">
                                                                            <%= food.portion_g %>g • <%= food.calories
                                                                                    %> cal
                                                                        </small>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <% }); %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <% if (mealIndex < day.meals.length - 1) { %>
                                        <hr class="my-4">
                                        <% } %>
                                            <% }); %>
                            </div>
                        </div>
                        <% }); %>
                </div>
            </div>
        </div>

        <!-- Weekly Summary -->
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">
                            <i class="bi bi-check-circle me-2"></i>Cumplimiento de Objetivos
                        </h6>
                    </div>
                    <div class="card-body">
                        <% const avgCalories=Math.round(plan.week_plan.reduce((sum, day)=> sum + day.total_calories, 0)
                            / plan.week_plan.length); %>
                            <% const avgProtein=Math.round(plan.week_plan.reduce((sum, day)=> sum + day.total_protein,
                                0) / plan.week_plan.length); %>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span>Calorías promedio</span>
                                        <span>
                                            <%= avgCalories %> cal
                                        </span>
                                    </div>
                                    <div class="progress">
                                        <div class="progress-bar bg-primary"
                                            style="width: <%= Math.min((avgCalories / 2500) * 100, 100) %>%"></div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span>Proteína promedio</span>
                                        <span>
                                            <%= avgProtein %>g
                                        </span>
                                    </div>
                                    <div class="progress">
                                        <div class="progress-bar bg-success"
                                            style="width: <%= Math.min((avgProtein / 150) * 100, 100) %>%"></div>
                                    </div>
                                </div>

                                <!-- Restrictions compliance -->
                                <% if (plan.restrictions && plan.restrictions.length> 0) { %>
                                    <div class="mb-3">
                                        <h6 class="text-success">
                                            <i class="bi bi-shield-check me-1"></i>Restricciones Respetadas:
                                        </h6>
                                        <% plan.restrictions.forEach(restriction=> { %>
                                            <span class="badge bg-success me-1 mb-1">
                                                <%= restriction.charAt(0).toUpperCase() +
                                                    restriction.slice(1).replace('_', ' ' ) %>
                                            </span>
                                            <% }); %>
                                    </div>
                                    <% } %>

                                        <!-- Allergies compliance -->
                                        <% if (plan.allergies && plan.allergies.length> 0) { %>
                                            <div class="mb-3">
                                                <h6 class="text-warning">
                                                    <i class="bi bi-exclamation-triangle me-1"></i>Alergias Evitadas:
                                                </h6>
                                                <% plan.allergies.forEach(allergy=> { %>
                                                    <span class="badge bg-warning me-1 mb-1">
                                                        <%= allergy %>
                                                    </span>
                                                    <% }); %>
                                            </div>
                                            <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Add meal to activities function
        function addMealToActivities(mealData) {
            console.log('Adding meal to activities:', mealData);
        }
    </script>

    <style>
        .meal-card {
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            padding: 1.5rem;
            background: #fff;
        }

        .meal-header {
            border-right: 1px solid #dee2e6;
            padding-right: 1rem;
        }

        .food-item {
            padding: 0.5rem;
            background: #f8f9fa;
            border-radius: 0.25rem;
            margin-bottom: 0.5rem;
        }

        .food-icon {
            width: 12px;
            flex-shrink: 0;
        }

        .nav-tabs .nav-link {
            color: #6c757d;
        }

        .nav-tabs .nav-link.active {
            background-color: #fff;
            color: #0d6efd;
            border-color: #dee2e6 #dee2e6 #fff;
        }

        .bg-gradient-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        }

        @media (max-width: 768px) {
            .meal-header {
                border-right: none;
                border-bottom: 1px solid #dee2e6;
                padding-right: 0;
                padding-bottom: 1rem;
                margin-bottom: 1rem;
            }
        }
    </style>
</body>

</html>